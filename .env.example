# Server-only secrets — copy to .env.local (never commit .env.local)

# Nebius Token Factory (OpenAI-compatible chat/completions)
# Docs: https://docs.nebius.com/studio/inference/quickstart
NEBIUS_API_KEY=your_nebius_token_factory_api_key

# Optional model override (default in code: nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B)
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Tavily web search for web_research / SEO research (server-only)
TAVILY_API_KEY=your_tavily_api_key
